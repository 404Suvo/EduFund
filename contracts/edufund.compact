/**
 * EduFund – Transparent Scholarship & Student Grant Distribution
 * Built on Midnight Network with Compact Smart Contracts
 * 
 * =========================================================================
 * PRIVACY MODEL & ZERO-KNOWLEDGE ARCHITECTURE
 * =========================================================================
 * 
 * 1. WHAT IS PUBLIC (ON-CHAIN LEDGER STATE):
 *    - admin: Authority public key responsible for accrediting educational merchants.
 *    - totalPool: Total scholarship capital deposited by donors/governments.
 *    - totalDisbursed: Cumulative grant amount redeemed across all students.
 *    - approvedMerchants: Map of verified educational vendors (colleges, bookshops, labs).
 *    - nullifiers: Map of spent grant commitment nullifiers. Prevents double-claiming
 *      without exposing which student claimed which voucher.
 *    - merchantRedemptions: Aggregated funds disbursed to each accredited merchant,
 *      granting donors 100% auditability that funds are spent on education.
 * 
 * 2. WHAT IS PRIVATE (WITNESSES & OFF-CHAIN STATE):
 *    - getAdminSecret(): Admin private key for authenticating management operations.
 *    - getMerchantSecret(): Private cryptographic credentials of accredited merchants.
 *    - Student Identity & Academic Records: Off-chain student credentials never touch
 *      the ledger, eliminating social stigma and financial surveillance.
 *    - Grant Voucher Secret & Salt: Used to generate the one-way nullifier hash.
 * 
 * 3. WHAT THE USER PROVES VIA ZERO-KNOWLEDGE CIRCUITS:
 *    - The student proves they possess an unspent, valid scholarship grant voucher.
 *    - The student proves the nullifier hash has never appeared on the public ledger.
 *    - The student proves the intended recipient merchant is currently accredited.
 *    - The student updates the merchant's redemption total and burns the voucher nullifier
 *      WITHOUT exposing their student ID, wallet address, or spending history.
 */

import CompactStandardLibrary;

export struct AdminPublicKey {
  bytes: Bytes<32>;
}

export struct AdminSecretKey {
  bytes: Bytes<32>;
}

export struct MerchantPublicKey {
  bytes: Bytes<32>;
}

export struct MerchantSecretKey {
  bytes: Bytes<32>;
}

// Private witnesses: secrets provided off-chain by the executing client
witness getAdminSecret(): AdminSecretKey;
witness getMerchantSecret(): MerchantSecretKey;

// Public on-chain ledger state
export ledger admin: AdminPublicKey;
export ledger totalPool: Uint<128>;
export ledger totalDisbursed: Uint<128>;
export ledger approvedMerchants: Map<MerchantPublicKey, Boolean>;
export ledger nullifiers: Map<Bytes<32>, Boolean>;
export ledger merchantRedemptions: Map<MerchantPublicKey, Uint<128>>;

// Constructor initializes the scholarship contract with the authority's public key
constructor(initialAdmin: AdminPublicKey) {
  admin = disclose(initialAdmin);
  totalPool = 0;
  totalDisbursed = 0;
}

// Circuit to derive admin public key from private witness secret
export circuit deriveAdminPublicKey(sk: AdminSecretKey): AdminPublicKey {
  return AdminPublicKey {
    bytes: persistentHash<Vector<2, Bytes<32>>>([
      pad(32, "edufund:admin:v1"),
      sk.bytes
    ])
  };
}

// Circuit to derive merchant public key from private witness secret
export circuit deriveMerchantPublicKey(sk: MerchantSecretKey): MerchantPublicKey {
  return MerchantPublicKey {
    bytes: persistentHash<Vector<2, Bytes<32>>>([
      pad(32, "edufund:merchant:v1"),
      sk.bytes
    ])
  };
}

// Donors or authorities deposit funds into the scholarship pool
export circuit depositPool(amount: Uint<128>): [] {
  assert(amount > 0, "Deposit amount must be greater than zero");
  totalPool = (totalPool + disclose(amount)) as Uint<128>;
}

// Admin accredits an educational merchant (e.g. university, academic bookstore)
export circuit registerMerchant(merchant: MerchantPublicKey): [] {
  const caller = deriveAdminPublicKey(getAdminSecret());
  assert(admin == caller, "Only admin can register educational merchants");
  approvedMerchants.insert(disclose(merchant), true);
  if (!merchantRedemptions.member(disclose(merchant))) {
    merchantRedemptions.insert(disclose(merchant), 0);
  }
}

// Admin can revoke or suspend an educational merchant
export circuit revokeMerchant(merchant: MerchantPublicKey): [] {
  const caller = deriveAdminPublicKey(getAdminSecret());
  assert(admin == caller, "Only admin can revoke educational merchants");
  assert(approvedMerchants.member(disclose(merchant)), "Merchant is not registered");
  approvedMerchants.insert(disclose(merchant), false);
}

// Student redeems their grant voucher directly to an approved educational merchant
// The student generates a ZK proof of holding a valid grant, revealing only the nullifier
export circuit redeemGrant(
  nullifier: Bytes<32>,
  merchant: MerchantPublicKey,
  amount: Uint<128>
): [] {
  // 1. Verify positive amount and sufficient scholarship pool balance
  assert(amount > 0, "Grant amount must be greater than zero");
  assert(totalPool >= ((totalDisbursed + disclose(amount)) as Uint<128>), "Insufficient scholarship pool balance");

  // 2. Verify target merchant is registered and active
  assert(approvedMerchants.member(disclose(merchant)), "Merchant is not approved");
  assert(approvedMerchants.lookup(disclose(merchant)), "Merchant is deactivated");

  // 3. Verify grant voucher has not been spent already (nullifier uniqueness check)
  assert(!nullifiers.member(disclose(nullifier)), "Grant voucher has already been redeemed");

  // 4. Mark nullifier as spent to prevent double-redemption
  nullifiers.insert(disclose(nullifier), true);

  // 5. Update cumulative disbursements
  totalDisbursed = (totalDisbursed + disclose(amount)) as Uint<128>;

  // 6. Credit the accredited merchant's redemption balance
  const currentRedeemed = merchantRedemptions.member(disclose(merchant))
    ? merchantRedemptions.lookup(disclose(merchant))
    : 0;
  merchantRedemptions.insert(disclose(merchant), (currentRedeemed + disclose(amount)) as Uint<128>);
}
