{
  "name": "edufund",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "EduFund – Transparent Scholarship & Student Grant Distribution on Midnight Network",
  "scripts": {
    "compile": "node ./scripts/compile.js",
    "test": "vitest run",
    "test:watch": "vitest",
